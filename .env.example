# Server only. Use the production Chat URL from your n8n Chat Trigger.
N8N_CHAT_URL=
# Required: credentials attached to the Chat Trigger's Basic Auth.
N8N_BASIC_AUTH_USERNAME=
N8N_BASIC_AUTH_PASSWORD=
# Quote special-character values; escape literal dollar signs as \$ in Next.js env files.

# Invite-only authentication (all values are server-side; never prefix with NEXT_PUBLIC_).
# The owner setup command generates BETTER_AUTH_SECRET if it is missing.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
OWNER_EMAIL=
# Set to Supabase's Transaction pooler URI in Vercel; leave blank for local SQLite.
DATABASE_URL=
# Optional CA override (PEM). Supabase Root 2021 CA is bundled for Supabase hosts.
# Paste the full certificate into Vercel; locally use a quoted multiline value.
DATABASE_SSL_CA=
# Used only when DATABASE_URL is blank. Defaults locally to data/auth.db.
AUTH_DATABASE_PATH=./data/auth.db
